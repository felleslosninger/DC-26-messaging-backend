{
  "name": "digdir-wallet-messaging-backend",
  "version": "0.1.0",
  "description": "Backend for sending issuer messages to the EUDI wallet app via APNs silent push.",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": "20 || 22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@parse/node-apn": "^8.1.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2"
  }
}
